{
  "name": "hacker-news-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:hn": "tsx --env-file=.env scripts/import-hn.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "gen:fixtures": "node scripts/gen-fixtures.cjs ../docs/project-idea/28-hacker-news-clone/impeccable/index.html",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:rls": "node scripts/verify-rls.mjs",
    "db:seed:big": "tsx --env-file=.env scripts/seed-big-threads.ts",
    "db:anonymise": "tsx --env-file=.env scripts/anonymise-authors.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
