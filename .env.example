# Copy to `.env` — NOT `.env.local`. The Prisma CLI does not read `.env.local`, which gives you a
# working app and a failing migration. `.gitignore` keeps `.env` out of the repo; this file is the
# only env file that is committed, and it must never hold a real credential.
#
# Both URLs come from the same Supabase project: Dashboard → Connect.
# Two different poolers, deliberately — see ARCHITECTURE Appendix D.

# The app's connection: TRANSACTION pooler, port 6543, ?pgbouncer=true.
# Serverless opens and drops connections constantly; this is the pooler built for that.
#
# IF 6543 TIMES OUT, you are on a network that blocks it (this one does). Point DATABASE_URL at
# :5432 without the pgbouncer flag and leave DATABASE_POOL_MAX unset. Everything works, but note
# what you are then NOT exercising: the transaction pooler itself. Deployment is its first run.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# `prisma migrate` only: SESSION pooler, port 5432. DDL and advisory locks need a real session and
# do not survive transaction pooling.
#
# `?schema=hacker_news_clone` belongs here and NOT on DATABASE_URL. It decides where
# `_prisma_migrations` lives, which matters because this Supabase project is shared with other apps:
# left in `public`, the next app that omits the parameter adopts this app's migrations as
# applied-but-missing-from-disk. The runtime does not need it — the generated client already
# qualifies every table, because the schema is declared in the Prisma schema (multiSchema).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=hacker_news_clone"

# Connections this process may hold. Unset means 3, sized for the SESSION pooler, which allows only
# 15 clients for the whole project while Next runs several render workers each holding its own pool
# — so the constraint is `workers x max < 15`, not `max < 15`. Exceeding it fails every query with
# `(EMAXCONNSESSION) max clients reached in session mode`, and the app still renders its shell with
# all the data missing, which reads like a UI bug.
#
# Deployed on the transaction pooler, set 6: it returns a connection per transaction rather than per
# client, so the ceiling moves to per-instance.
# DATABASE_POOL_MAX=6

# ---------------------------------------------------------------------------
# Clerk (M10). Keys come from the dashboard for the application this project
# is linked to; `clerk env pull` writes them into `.env`, so do not paste real
# ones here. The publishable key is safe in client bundles, the secret is not.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk sends you after signing in or up when it has no page of its own
# to return to. `/welcome` and not `/`: a brand-new account has no User row
# yet, and `/welcome` is the only screen that asks for the username. An active
# account is bounced straight home by the gate there, which costs one 307.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/welcome
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome
